{
  "name": "sugarmill/email-templates",
  "version": "1.0.0",
  "description": "Declarative transactional email rendering: layouts, operator-editable bodies, and typed components. Tags are escaped for the context they land in, and an unresolved tag never reaches a customer. Zero dependencies.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarmill/email-templates",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["email", "templates", "html-email", "transactional", "layouts", "components"],
  "require": { "php": ">=8.5" },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "suggest": { "sugarmill/mailer": "To deliver the rendered result (Postmark, Resend, SES, Cloudflare, SMTP)." },
  "autoload": { "psr-4": { "SugarMill\\EmailTemplates\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarMill\\EmailTemplates\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarmill/email-templates/issues", "source": "https://github.com/sugarmill/email-templates" }
}
